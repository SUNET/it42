# Core zone (it42.vr). Copied to env/core.env by scripts/make-env.sh.
APP_ROLE=core
IT42_RUNTIME=1
SITE_HOST=it42.vr
SITE_NAME=IT42 Grants
THEME_COLOR=#020344
DJANGO_SECRET_KEY=__RANDOM__
POSTGRES_HOST=core-db
